/*
 * Cascade layer order: unlayered rules (this file's own selectors below,
 * plus Tailwind's `components`/`utilities` output) always win over anything
 * layered, regardless of specificity. Within the layered tier, `antd`
 * outranks `reset` — so AntD's component CSS overrides Tailwind's preflight
 * reset instead of the other way around. AntD's cssinjs runtime (see
 * `<StyleProvider layer>` in main.jsx) injects its styles into this same
 * `antd` layer at runtime.
 *
 * The layer is named `reset`, not `base` — Tailwind v3 reserves the literal
 * name `base` (and `components`/`utilities`) for its own `@layer base {}`
 * customization syntax and silently drops a nested `@tailwind base;`
 * directive inside a block with that reserved name.
 */
@layer reset, antd;

@layer reset {
  @tailwind base;
}

@tailwind components;
@tailwind utilities;

:root {
  --text: #6b6375;
  --text-h: #08060d;
  --bg: #fff;
  --border: #e5e4e7;
  --code-bg: #f4f3ec;
  --accent: #aa3bff;
  --accent-bg: rgba(170, 59, 255, 0.1);
  --accent-border: rgba(170, 59, 255, 0.5);
  --social-bg: rgba(244, 243, 236, 0.5);
  --shadow:
    rgba(0, 0, 0, 0.1) 0 10px 15px -3px, rgba(0, 0, 0, 0.05) 0 4px 6px -2px;
  --pms-bg-container: #ffffff;
  --pms-bg-layout: #f3f4f6;
  --pms-border: #e5e7eb;
  --pms-row-hover: #fffdf9;

  --sans: 'Inter', system-ui, 'Segoe UI', Roboto, sans-serif;
  --heading: 'Lora', Georgia, serif;
  --mono: ui-monospace, Consolas, monospace;

  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.5;
  letter-spacing: 0.18px;
  color-scheme: light;
  color: var(--text);
  background: var(--bg);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
