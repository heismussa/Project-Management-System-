        <Segmented
          size="small"
          value={record.status}
          options={REQUIREMENT_STATUSES}
          onChange={(value) => updateRequirement(record.id, { status: value })}
        />
      ),
    },
    {
      title: 'Test result',
      key: 'testResult',
      width: 220,
      render: (_, record) => (
        <Segmented
          size="small"
          value={record.testResult}
