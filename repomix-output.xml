/*
 * Cascade layer order: unlayered rules (this file's own selectors below,
 * plus Tailwind's `components`/`utilities` output) always win over anything
 * layered, regardless of specificity. Within the layered tier, `antd`
 * outranks `reset` — so AntD's component CSS overrides Tailwind's preflight
 * reset instead of the other way around. AntD's cssinjs runtime (see
 * `<StyleProvider layer>` in main.jsx) injects its styles into this same
 * `antd` layer at runtime.
 *
 * The layer is named `reset`, not `base` — Tailwind v3 reserves the literal
 * name `base` (and `components`/`utilities`) for its own `@layer base {}`
 * customization syntax and silently drops a nested `@tailwind base;`
 * directive inside a block with that reserved name.
 */
@layer reset, antd;

@layer reset {
  @tailwind base;
}

@tailwind components;
@tailwind utilities;

:root {
  --text: #6b6375;
  --text-h: #08060d;
  --bg: #fff;
  --border: #e5e4e7;
  --code-bg: #f4f3ec;
  --accent: #aa3bff;
  --accent-bg: rgba(170, 59, 255, 0.1);
  --accent-border: rgba(170, 59, 255, 0.5);
  --social-bg: rgba(244, 243, 236, 0.5);
  --shadow:
    rgba(0, 0, 0, 0.1) 0 10px 15px -3px, rgba(0, 0, 0, 0.05) 0 4px 6px -2px;
  --pms-bg-container: #ffffff;
  --pms-bg-layout: #f3f4f6;
  --pms-border: #e5e7eb;
  --pms-row-hover: #fffdf9;

  --sans: 'Inter', system-ui, 'Segoe UI', Roboto, sans-serif;
  --heading: 'Lora', Georgia, serif;
  --mono: ui-monospace, Consolas, monospace;

  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.5;
  letter-spacing: 0.18px;
  color-scheme: light;
  color: var(--text);
  background: var(--bg);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
}

#root {
  min-height: 100svh;
}

/* Implementation Plan table (see ConfigProvider in ActivitiesTable.jsx for
   the color/hover tokens this complements — header bg/color, row hover,
   and cell horizontal padding are handled there). This covers the pixel
   dimensions AntD doesn't expose as tokens. */
.plan-table .ant-table-thead > tr > th {
  height: 54px;
  font-weight: 600;
}

.plan-table .ant-table-tbody > tr > td {
  min-height: 82px;
  border-bottom: 1px solid #eceff2;
  vertical-align: middle;
}

.plan-table .ant-table-tbody > tr.selected-row > td {
  background: linear-gradient(90deg, #fff4d8 0%, #fff9eb 100%);
  border-bottom-color: #fff4d8;
}

.plan-table .ant-table-tbody > tr.selected-row > td:first-child {
  box-shadow: inset 3px 0 0 #d9a323;
}

/* Traceability Matrix: keep headers on one line; narrow fixed columns, flex text columns */
.matrix-table .ant-table-thead > tr > th .ant-table-column-title {
  white-space: nowrap;
}

/* Shared data-table helpers — brand header color across app tables */
.plan-table .ant-table-thead > tr > th,
.ictms-table .ant-table-thead > tr > th,
.matrix-table .ant-table-thead > tr > th {
  white-space: nowrap;
  background: #962c30 !important;
  color: #fff !important;
}

.plan-table .ant-table-cell,
.ictms-table .ant-table-cell,
.matrix-table .ant-table-cell {
  vertical-align: middle;
}

/* House table style (DataTable.jsx spec) applied to AntD Table instances
   that keep antd's sorting/filtering/pagination instead of migrating to
   DataTable. Colors/padding/fontSize come from the ConfigProvider Table
   tokens in AppProviders.jsx; this covers the pixel heights and borders
   those tokens don't expose. */
.pms-house-table .ant-table-thead > tr > th {
  height: 45px;
  font-weight: 600;
  border-right: 1px solid rgba(255, 255, 255, 0.55);
}

.pms-house-table .ant-table-thead > tr > th:last-child {
  border-right: none;
}

.pms-house-table .ant-table-tbody > tr > td {
  height: 52px;
  border: 1px solid rgba(0, 0, 0, 0.04);
  vertical-align: middle;
}

.pms-house-table .ant-table-tbody > tr:hover > td {
  background: #fafafa;
}

.nav-link.active {
  background-color: #962c30;
  color: #fff;
}

.nav-link.active .nav-icon {
  color: #fff;
}

.navbar-drawer-item {
  display: flex;
  width: 100%;
  border-radius: 0.375rem;
  border: 1px solid #e5e7eb;
  padding: 0.25rem 0.75rem;
  font-weight: 600;
  line-height: 1.5rem;
  color: #962c30;
}

.navbar-drawer-item:hover {
  background-color: #962c30;
  color: #fff;
}

html.dark {
  --pms-bg-container: #17212b;
  --pms-bg-layout: #111827;
  --pms-border: #2a3947;
  --pms-row-hover: #1e2d3a;
  background-color: var(--pms-bg-layout);
}

.dark body,
.dark #root {
  background-color: var(--pms-bg-layout);
  color: #e5e7eb;
}

.page-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: 16px;
}

.page-shell-card,
.pms-table-shell {
  margin-top: 12px;
  overflow: hidden;
  border-radius: 0.75rem;
  border: 1px solid var(--pms-border);
  background-color: var(--pms-bg-container);
  padding: 12px;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
}

/* antd's Card adds its own ~24px body padding on top of the padding above,
   doubling the gutter on every page that uses .page-shell-card. Zero the
   inner one out so there's a single, consistent gap everywhere — an inline
   `styles={{ body: { padding: ... } }}` on any individual Card still wins
   over this if a page needs something different. */
.page-shell-card > .ant-card-body {
  padding: 0;
}

.pms-table-shell {
  margin-top: 0;
  padding: 0;
}

.dark .page-shell-card,
.dark .pms-table-shell {
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.24);
}

/* Table body surfaces follow container token in dark mode */
.dark .plan-table .ant-table,
.dark .matrix-table .ant-table,
.dark .ictms-table .ant-table,
.dark .ant-table-wrapper .ant-table {
  background: var(--pms-bg-container);
}

.dark .plan-table .ant-table-tbody > tr > td,
.dark .matrix-table .ant-table-tbody > tr > td,
.dark .ictms-table .ant-table-tbody > tr > td {
  border-bottom-color: var(--pms-border);
}

.dark .plan-table .ant-table-tbody > tr:hover > td,
.dark .matrix-table .ant-table-tbody > tr:hover > td,
.dark .ictms-table .ant-table-tbody > tr:hover > td {
  background: var(--pms-row-hover) !important;
}

.dark .plan-table .ant-table-tbody > tr.selected-row > td {
  background: linear-gradient(90deg, #2a2418 0%, #1e2d3a 100%);
  border-bottom-color: #3d3420;
}

.dark .plan-table .ant-table-tbody > tr.selected-row > td:first-child {
  box-shadow: inset 3px 0 0 #d9a323;
}

/* Hide the classic up/down scrollbar arrow buttons everywhere (Chromium).
   The app relies on the draggable thumb + wheel/trackpad; the arrow
   buttons just added visual noise on every scrollable panel. */
*::-webkit-scrollbar-button {
  display: none;
  width: 0;
  height: 0;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  border-radius: 61.5px;
  border: 3px solid #ffffff;
  background-color: rgb(172, 0, 0);
  color: #ffffff;
  font-size: 28px;
  font-weight: 600;
  flex-shrink: 0;
}

.avatar-name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: calc(100% - 40px);
  margin: 8px 0 4px;
  font-size: 20px;
  font-weight: 700;
}

.avatar-email {
  font-size: 12px;
  line-height: 1.33;
  font-weight: 400;
  color: rgb(57, 58, 61);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: calc(100% - 40px);
  margin: 0 0 12px;
}

.dark .avatar-email {
  color: #9ca3af;
}
