            'Project Implementor' => ['projects.implement', 'projects.view_all'],
            'Project ViewOnly' => ['projects.view_all'],
            'Project Administrator' => Permission::all()->pluck('code')->toArray(),
        ];

        $descriptions = [
            'ICT Support' => 'Manages user accounts and role assignment',
