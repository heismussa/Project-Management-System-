        foreach ($roles as $roleName => $permCodes) {
            $role = Role::firstOrCreate(
                ['name' => $roleName],
                ['description' => $descriptions[$roleName] ?? null]
            );
            $permIds = Permission::whereIn('code', $permCodes)->pluck('id');
            $role->permissions()->sync($permIds);
