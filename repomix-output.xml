import { useCallback, useEffect, useMemo, useState } from 'react'
import { Link, useParams, useSearchParams } from 'react-router-dom'
import { Alert, Descriptions, Space, Spin, Table, Tabs, Tag, Typography, message } from 'antd'
import dayjs from 'dayjs'
import api from '../lib/axios'
import { storeProjectId, unwrapItem, unwrapList } from '../lib/apiHelpers'
import { useActiveRoleName } from '../components/common/RoleGuard'
import { ROLES } from '../utility/Config.jsx'
import ImplementationPlanPage from './ImplementationPlanPage'
import TraceabilityTable from '../components/matrix/TraceabilityTable'
import DocumentList from '../components/documents/DocumentList'
import ReviewsPage from './ReviewsPage'
import ClosurePanel from '../components/projects/ClosurePanel'

const { Title, Text } = Typography

const TAB_KEYS = ['overview', 'plan', 'rtm', 'progress', 'documents', 'reviews', 'closure', 'audit']

function ProjectDetailPage() {
  const { id } = useParams()
  const [searchParams, setSearchParams] = useSearchParams()
  const roleName = useActiveRoleName()
  const isPlanner = roleName === ROLES.PPL
  const projectId = Number(id)
  const requestedTab = searchParams.get('tab') || (isPlanner ? 'plan' : 'overview')
  const tab = TAB_KEYS.includes(requestedTab) ? requestedTab : isPlanner ? 'plan' : 'overview'

  const [project, setProject] = useState(null)
  const [workflow, setWorkflow] = useState(null)
  const [reviews, setReviews] = useState([])
  const [closure, setClosure] = useState(null)
  const [loading, setLoading] = useState(false)

  const canSeeReviews = [ROLES.PRV, ROLES.PCO, ROLES.PAP, ROLES.PAD].includes(roleName)

  const load = useCallback(async () => {
    if (!Number.isFinite(projectId)) return
    setLoading(true)
    try {
      const [showRes, workflowRes, reviewsRes, closureRes] = await Promise.all([
        api.get(`/projects/${projectId}`),
        api.get(`/projects/${projectId}/workflow`),
        api.get(`/projects/${projectId}/reviews`).catch(() => ({ data: { data: [] } })),
        api.get(`/projects/${projectId}/closure-readiness`).catch(() => ({ data: { data: null } })),
      ])
      setProject(unwrapItem(showRes.data))
      setWorkflow(workflowRes.data?.data ?? showRes.data?.workflow ?? null)
      setReviews(unwrapList(reviewsRes.data))
      setClosure(closureRes.data?.data || null)
      storeProjectId(projectId)
    } catch (err) {
      message.error(err.response?.data?.message || 'Could not load project.')
    } finally {
      setLoading(false)
    }
  }, [projectId])

  useEffect(() => {
    load()
  }, [load])

  const items = useMemo(() => {
    const tabs = [
      {
        key: 'overview',
        label: 'Overview',
        children: project ? (
          <Descriptions bordered size="small" column={{ xs: 1, sm: 2 }}>
            <Descriptions.Item label="APR">{project.annual_plan_reference || '—'}</Descriptions.Item>
            <Descriptions.Item label="Status">{project.status || '—'}</Descriptions.Item>
            <Descriptions.Item label="Category">{project.category || '—'}</Descriptions.Item>
            <Descriptions.Item label="Track">{workflow?.review_track || project.review_track || '—'}</Descriptions.Item>
            <Descriptions.Item label="Planner">{project.planner?.name || '—'}</Descriptions.Item>
            <Descriptions.Item label="Reviewer">{project.reviewer?.name || '—'}</Descriptions.Item>
            <Descriptions.Item label="Queue">{(workflow?.queue || '—').replaceAll('_', ' ')}</Descriptions.Item>
            <Descriptions.Item label="Phase">{project.phase || '—'}</Descriptions.Item>
            <Descriptions.Item label="Description" span={2}>
              {project.description || '—'}
            </Descriptions.Item>
          </Descriptions>
        ) : null,
      },
      { key: 'plan', label: 'Plan', children: <ImplementationPlanPage embedded /> },
      { key: 'rtm', label: 'RTM', children: <TraceabilityTable embedded /> },
      { key: 'progress', label: 'Progress log', children: <ImplementationPlanPage embedded /> },
      { key: 'documents', label: 'Documents', children: <DocumentList embedded /> },
    ]

    if (canSeeReviews) {
      tabs.push({ key: 'reviews', label: 'Reviews', children: <ReviewsPage embedded /> })
    }

    tabs.push(
      {
        key: 'closure',
        label: 'Closure',
        children: (
          <ClosurePanel projectId={projectId} closure={closure} workflow={workflow} onChanged={load} />
        ),
      },
      {
        key: 'audit',
        label: 'Audit',
        children: (
          <Table
            rowKey="id"
            pagination={false}
            dataSource={reviews}
            columns={[
              { title: 'Type', dataIndex: 'entity_type' },
              { title: 'Decision', dataIndex: 'decision', render: (value) => <Tag>{value}</Tag> },
              { title: 'Role', dataIndex: 'role_snapshot', render: (value) => value || '—' },
              { title: 'Comment', dataIndex: 'comment', render: (value) => value || '—' },
              {
                title: 'When',
                dataIndex: 'reviewed_at',
                render: (value) => (value ? dayjs(value).format('MMM D, YYYY h:mm A') : '—'),
              },
            ]}
          />
        ),
      },
    )

    return tabs
  }, [project, workflow, canSeeReviews, projectId, closure, load, reviews])

  const activePanel = items.find((item) => item.key === tab)?.children
    ?? items.find((item) => item.key === 'plan')?.children
    ?? null

  if (!Number.isFinite(projectId)) {
    return <Alert type="error" message="Invalid project." />
  }

  return (
    <Spin spinning={loading && !project}>
      {!isPlanner && (
        <div className="mb-4">
          <Link to="/projects" className="text-sm text-[#650018]">
            ← Project Management
          </Link>
          <Title level={4} className="!mb-1 mt-2">
            {project?.name || 'Project'}
          </Title>
          <Space wrap>
            <Text type="secondary">{project?.annual_plan_reference}</Text>
            {workflow?.queue && <Tag>{workflow.queue.replaceAll('_', ' ')}</Tag>}
            {workflow?.review_track && <Tag color="blue">{workflow.review_track}</Tag>}
          </Space>
        </div>
      )}

      {isPlanner ? (
        activePanel
      ) : (
        <Tabs
          activeKey={tab}
          onChange={(next) => {
            const params = new URLSearchParams(searchParams)
            params.set('tab', next)
            setSearchParams(params, { replace: true })
          }}
          items={items}
          destroyInactiveTabPane
        />
      )}
    </Spin>
  )
}

export default ProjectDetailPage
</file>

