function relativeTime(value) {
  if (!value) return '—'
  const diffMs = Date.now() - new Date(value).getTime()
  const hours = Math.max(0, Math.round(diffMs / (1000 * 60 * 60)))
  if (hours < 1) return 'now'
  if (hours < 24) return `${hours}h`
  return `${Math.round(hours / 24)}d`
}

